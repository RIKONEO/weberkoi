# Baza PostgreSQL (np. Neon, Supabase albo Vercel Postgres).
DATABASE_URL=postgres://user:haslo@host:5432/weberkoi

# Hasło do panelu /admin i losowy sekret (min. 32 znaki) do podpisywania sesji.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Bunny Stream: filmiki ofert wgrywane z telefonu w panelu. Bez tych trzech pól
# w panelu zostaje tylko wklejanie linku do filmiku.
# Numer biblioteki (Stream → biblioteka → API → Video Library ID)
BUNNY_STREAM_LIBRARY_ID=
# Klucz API tej biblioteki (Stream → biblioteka → API → API Key). Tylko w Vercelu, nigdy w repo.
BUNNY_STREAM_API_KEY=
# Adres CDN biblioteki, np. vz-12345678-abc.b-cdn.net (Stream → biblioteka → API → CDN Hostname)
BUNNY_STREAM_CDN_HOST=
