# Baza PostgreSQL (np. Neon, Supabase albo Vercel Postgres).
DATABASE_URL=postgres://user:haslo@host:5432/weberkoi

# Hasło do panelu /admin i losowy sekret (min. 32 znaki) do podpisywania sesji.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Stripe (dashboard.stripe.com → Developers): klucz tajny i sekret webhooka dla adresu
# https://<domena>/api/stripe ze zdarzeniami checkout.session.completed, .expired,
# .async_payment_succeeded i .async_payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Adres sklepu, na który Stripe odsyła klienta po płatności.
SITE_URL=https://weberkoi.pl
